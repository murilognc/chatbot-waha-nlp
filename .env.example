# Copie este arquivo para .env e personalize os valores.
# Gere uma chave aleatória: openssl rand -hex 24
WAHA_API_KEY=ChatbotAula2026_MinhaChave123

# Apple Silicon (M1/M2/M3/M4): devlikeapro/waha:arm
# Windows/Linux x86_64: devlikeapro/waha:latest
WAHA_IMAGE=devlikeapro/waha:latest
WHATSAPP_DEFAULT_ENGINE=WEBJS

# O nome deve ser igual ao nome da sessão criada no Dashboard da WAHA.
WAHA_SESSION=default

# Portas locais. Altere se já estiverem ocupadas no computador.
WAHA_PORT=3000
CHATBOT_PORT=3001

# true envia respostas ao WhatsApp; false apenas processa o webhook.
SEND_ENABLED=true
